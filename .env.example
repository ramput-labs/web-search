# Copy to .env; the Makefile reads it. Every value here is the default.

# FastAPI server
HOST=127.0.0.1
PORT=8009
LOG_LEVEL=info
WORKERS=1
# Only needed when a browser calls the server directly; the UI proxies /api instead
CORS_ORIGINS=

# Upstreams
KEV_URL=http://localhost:8010
KEV_TIMEOUT=120
SEARXNG_URL=http://localhost:8888

# Search
SEARCH_THRESHOLD=0.5
SEARCH_MAX_ROUNDS=2
SEARCH_RESULTS=5
SEARCH_MAX_EVIDENCE=10
SEARCH_SNIPPET_CHARS=500
SEARCH_LANGUAGE=auto

# SvelteKit UI
UI_HOST=127.0.0.1
UI_PORT=5173
